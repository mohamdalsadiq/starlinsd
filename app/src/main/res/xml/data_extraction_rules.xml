<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
        <include domain="sharedpref" path="expander.xml" />
    <include domain="sharedpref" path="status_panel.xml" />
        <include domain="file" path="before-restore.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="expander.xml" />
    <include domain="sharedpref" path="status_panel.xml" />
        <include domain="file" path="before-restore.json" />
    </device-transfer>
</data-extraction-rules>
